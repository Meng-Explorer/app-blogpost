@{
    ViewData["Title"] = "Access Denied";
}

<div class="content-wrapper max-w-auth text-center py-5">
    <div class="brand-icon-box mx-auto mb-4" style="width: 64px; height: 64px; background: linear-gradient(135deg, #f59e0b, #ef4444);">
        <i class="bi bi-shield-slash-fill text-white fs-2"></i>
    </div>
    <h2 class="h3 fw-bold text-white mb-2">Access Denied</h2>
    <p class="text-white-50 mb-4">
        You do not have the required permissions or administrator privileges to view this section.
    </p>
    <a asp-controller="Post" asp-action="Index" class="btn btn-modern-primary px-4">
        <i class="bi bi-house-door"></i> Back to Homepage
    </a>
</div>