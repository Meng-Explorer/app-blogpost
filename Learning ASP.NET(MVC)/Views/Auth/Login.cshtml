@model LoginViewModels
@{
    ViewData["Title"] = "Sign In";
}

<div class="content-wrapper max-w-auth">
    <div class="text-center mb-4">
        <div class="brand-icon-box mx-auto mb-3" style="width: 54px; height: 54px;">
            <i class="bi bi-person-fill-lock text-white fs-3"></i>
        </div>
        <h2 class="h3 fw-bold text-white mb-1">Welcome Back</h2>
        <p class="text-white-50 small mb-0">Sign in to access your account and participate</p>
    </div>

    <form asp-action="Login" asp-controller="Auth" method="post">
        <div asp-validation-summary="All" class="alert alert-danger bg-danger bg-opacity-25 border-danger text-white rounded-3 py-2 mb-3"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email Address</label>
            <div class="input-group">
                <span class="input-group-text bg-white bg-opacity-10 border-0 text-white-50">
                    <i class="bi bi-envelope"></i>
                </span>
                <input asp-for="Email" class="form-control" type="email" placeholder="name@example.com" />
            </div>
            <span asp-validation-for="Email" class="text-warning small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Password" class="form-label">Password</label>
            <div class="input-group">
                <span class="input-group-text bg-white bg-opacity-10 border-0 text-white-50">
                    <i class="bi bi-shield-lock"></i>
                </span>
                <input asp-for="Password" class="form-control" type="password" placeholder="Enter your password" />
            </div>
            <span asp-validation-for="Password" class="text-warning small"></span>
        </div>

        <div class="d-grid gap-2 mb-4">
            <button type="submit" class="btn btn-modern-success py-2 fs-6">
                <i class="bi bi-box-arrow-in-right"></i> Sign In
            </button>
        </div>

        <div class="text-center pt-3 border-top border-white border-opacity-10">
            <p class="text-white-50 small mb-2">Don't have an account?</p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-action="Register" asp-controller="Auth" class="btn btn-sm btn-modern-outline">
                    <i class="bi bi-person-plus"></i> Create Account
                </a>
                <a asp-action="Index" asp-controller="Post" class="btn btn-sm btn-modern-outline">
                    <i class="bi bi-house"></i> Home
                </a>
            </div>
        </div>
    </form>
</div>
