@model DashboardViewModels
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="dashboard-wrapper max-w-dashboard">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom border-white border-opacity-10">
        <div>
            <h2 class="h3 fw-bold text-white mb-1">
                <i class="bi bi-people-fill text-info me-2"></i>User Management
            </h2>
            <p class="text-white-50 small mb-0">Overview of registered accounts and permissions</p>
        </div>

        <a class="btn btn-modern-success" asp-action="Create" asp-controller="Dashboard">
            <i class="bi bi-person-plus-fill"></i> Add New User
        </a>
    </div>
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger bg-danger bg-opacity-25 border-danger text-white rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-octagon-fill fs-5"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Stat Metric Bar -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-md-4">
            <div class="stat-card w-100">
                <div class="stat-icon">
                    <i class="bi bi-person-lines-fill"></i>
                </div>
                <div>
                    <div class="text-white-50 small text-uppercase fw-bold letter-spacing-1">Total Users</div>
                    <div class="h3 fw-bold text-white mb-0">@Model.TotalUsers</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Responsive Table -->
    <div class="table-responsive rounded-3">
        <table class="glass-table">
            <thead>
                <tr>
                    <th>Email Address</th>
                    <th>Assigned Roles</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users != null && Model.Users.Any())
                {
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="author-avatar-sm" style="background: linear-gradient(135deg, #6366f1, #3b82f6);">
                                        @(string.IsNullOrWhiteSpace(user.Email) ? "U" : user.Email.Substring(0, 1).ToUpper())
                                    </div>
                                    <span class="fw-semibold text-white">@user.Email</span>
                                </div>
                            </td>
                            <td>
                                @if (user.Roles != null && user.Roles.Any())
                                {
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge rounded-pill @(role == "Admin" ? "bg-warning text-dark" : "bg-info text-dark") me-1 px-3 py-1">
                                            @role
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-white-50 fst-italic small">No Role Assigned</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="Delete" asp-controller="Dashboard" asp-route-id="@user.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-modern-danger px-3 py-1" onclick="return confirm('Are you sure you want to delete this user?');">
                                        <i class="bi bi-trash3"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-white-50 py-4">
                            No users found in the system.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>