@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="content-wrapper max-w-post">
    <!-- Header -->
    <div class="mb-4 pb-3 border-bottom border-white border-opacity-10">
        <h1 class="h2 fw-bold text-white mb-1">
            <i class="bi bi-shield-check text-info me-2"></i>Privacy Policy
        </h1>
        <p class="text-white-50 small mb-0">Last updated: September 28, 2026</p>
    </div>

    <div class="text-white-75" style="line-height: 1.8;">
        <h3 class="h5 text-white fw-bold mt-4 mb-2">1. Introduction</h3>
        <p>
            Welcome to Modern Blog. We respect your privacy and are committed to protecting your personal data. 
            This privacy policy informs you about how we handle and protect your personal information when you visit 
            our application, read articles, leave comments, and manage accounts.
        </p>

        <h3 class="h5 text-white fw-bold mt-4 mb-2">2. Information We Collect</h3>
        <p>We may collect and process the following information when you interact with our platform:</p>
        <ul>
            <li><strong>Identity & Account Data:</strong> Username, email address, password hash, and assigned roles.</li>
            <li><strong>User Submissions:</strong> Blog post content, comments, timestamps, and uploaded media.</li>
            <li><strong>Technical Data:</strong> Browser user agent, device screen resolutions, and access logs for security audits.</li>
        </ul>

        <h3 class="h5 text-white fw-bold mt-4 mb-2">3. How We Use Your Information</h3>
        <p>Your data is used solely to provide and enhance our services:</p>
        <ul>
            <li>To securely authenticate and authorize user sessions.</li>
            <li>To publish articles and enable community discussions via comments.</li>
            <li>To ensure security, prevent spam, and maintain platform stability.</li>
        </ul>

        <h3 class="h5 text-white fw-bold mt-4 mb-2">4. Data Security</h3>
        <p>
            We implement industry-standard encryption, password hashing, and role-based access control (RBAC) to ensure 
            your account credentials and personal details remain safe from unauthorized access.
        </p>

        <h3 class="h5 text-white fw-bold mt-4 mb-2">5. Contact Information</h3>
        <p class="mb-0">
            If you have any questions or feedback regarding this policy, feel free to contact the administrator or reach out via our support channels.
        </p>
    </div>

    <div class="mt-5 pt-3 border-top border-white border-opacity-10">
        <a asp-action="Index" asp-controller="Post" class="btn btn-sm btn-modern-outline">
            <i class="bi bi-arrow-left"></i> Return to Blog
        </a>
    </div>
</div>
