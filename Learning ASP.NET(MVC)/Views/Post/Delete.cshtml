@model Post
@{
    ViewData["Title"] = "Delete Post Confirmation";
}

<div class="content-wrapper max-w-auth text-center">
    <div class="mb-4">
        <div class="brand-icon-box mx-auto mb-3" style="width: 56px; height: 56px; background: linear-gradient(135deg, #ef4444, #dc2626);">
            <i class="bi bi-exclamation-triangle-fill text-white fs-3"></i>
        </div>
        <h2 class="h3 fw-bold text-white mb-2">Delete Article</h2>
        <p class="text-white-50">Are you sure you want to permanently delete this article?</p>
    </div>

    @if (Model != null)
    {
        <div class="p-3 mb-4 rounded-3 text-start" style="background: rgba(0, 0, 0, 0.25); border: 1px solid rgba(255, 255, 255, 0.1);">
            <h5 class="fw-bold text-white mb-1">@Model.Title</h5>
            <div class="small text-white-50">
                <span>By @Model.Author</span> &bull; <span>@Model.PublishDate.ToString("MMM dd, yyyy")</span>
            </div>
        </div>
    }

    <form asp-controller="Post" asp-action="DeleteConfirm" method="post">
        <input name="Id" value="@Model?.Id" type="hidden" />
        <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
            <button type="submit" class="btn btn-modern-danger px-4">
                <i class="bi bi-trash3"></i> Yes, Delete Post
            </button>
            <a asp-action="Index" asp-controller="Post" class="btn btn-modern-outline px-4">Cancel</a>
        </div>
    </form>
</div>